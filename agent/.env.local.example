# Copy to .env.local and fill in from your LiveKit Cloud project (Settings > API keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: the avatar's voice, from one of two routes.
#   inference  (default) LiveKit Inference. AVATAR_VOICE is a Cartesia voice (default "Blake") or a
#              LiveKit custom voice ID (v_...): Voices > Custom voices in LiveKit Cloud, paid plan.
#   elevenlabs The ElevenLabs plugin with your own API key. AVATAR_VOICE is an ElevenLabs voice ID
#              from your account (a library voice or your own clone).
# AVATAR_TTS_PROVIDER=inference
# AVATAR_VOICE=
# AVATAR_TTS_MODEL=            # defaults: cartesia/sonic-3, or eleven_flash_v2_5 for elevenlabs
# ELEVEN_API_KEY=              # only for the elevenlabs route

# Optional: the LLM, any model LiveKit Inference offers (default openai/gpt-5.4-mini).
# AVATAR_LLM=openai/gpt-5.5

# For local development, so localhost gets your local agent rather than a deployed one.
AVATAR_AGENT_NAME=avatar-agent-dev
