# Copy to .env.local and fill in from your LiveKit Cloud project (Settings > API keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: the avatar's voice. Defaults to Cartesia "Blake". For your own voice, create a clone in
# LiveKit Cloud (Voices > Custom voices; paid plan) and paste its v_... ID here.
# AVATAR_VOICE=
# AVATAR_TTS_MODEL=cartesia/sonic-3

# For local development, so localhost gets your local agent rather than a deployed one.
AVATAR_AGENT_NAME=avatar-agent-dev
